/* The application manifest (starfox.manifest), icon (starfox.ico), and PE version info of starfox.exe.
   tools/build_game.py compiles it with the runtime objects. */
#include <winver.h>

1 24 "starfox.manifest"
1 ICON "starfox.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SteelTemple"
            VALUE "FileDescription", "Star Fox"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "starfox"
            VALUE "OriginalFilename", "starfox.exe"
            VALUE "ProductName", "Star Fox"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
